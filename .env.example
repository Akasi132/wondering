# Which backend generates lessons: anthropic (default) or openai.
LLM_PROVIDER=anthropic

# --- provider=anthropic ---
ANTHROPIC_API_KEY=

# --- provider=openai (any OpenAI-compatible Chat Completions endpoint) ---
# NVIDIA:   https://integrate.api.nvidia.com/v1   (key from build.nvidia.com, starts nvapi-)
# OpenAI:   https://api.openai.com/v1
# local:    http://localhost:8000/v1              (vLLM, llama.cpp, LM Studio, Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# Model ID. Leave blank to use the per-provider default
# (anthropic -> claude-sonnet-5, openai -> minimaxai/minimax-m2).
# Run `python main.py --list-models` to see what your endpoint actually serves — slugs vary
# by host and the openai default above is a guess, not a verified ID.
LLM_MODEL=

# How to ask for JSON on the openai path: auto (default), json_schema, json_object, none.
# auto tries each in turn and remembers the first the endpoint accepts.
LLM_JSON_MODE=auto

# Sampling temperature for the openai path. Blank = use the endpoint's default.
# MiniMax M2 recommends 1.0; leave blank unless you have a reason.
LLM_TEMPERATURE=

# --- YouTube transcript proxy (deployed instances only) ---
# Leave ALL of these blank for local use. A residential connection fetches transcripts fine;
# a datacenter one usually cannot. YouTube blocks cloud IP ranges, so a deployed instance gets
# RequestBlocked on videos that work from a laptop, and the site returns 503 saying so.
#
# Article URLs are unaffected — this only concerns YouTube.
#
# Option 1: Webshare (what youtube-transcript-api documents for this). Buy *residential*
# proxies, not datacenter ones — datacenter proxies are blocked for the same reason your
# server is. Takes precedence if both options are set.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Option 2: any other proxy provider. Either or both may be set.
YOUTUBE_PROXY_HTTP_URL=
YOUTUBE_PROXY_HTTPS_URL=

# Option 3: rotation over a list of free proxies. Free, and works more often than you would
# expect, but it is best-effort — see NOTES.md for measured numbers. Only used when neither
# option above is set, and only after a direct attempt comes back blocked.
#
# Set to 1 to enable. Off by default: it routes transcript requests through third-party
# proxies nobody has vetted, which should be a deliberate choice.
YOUTUBE_PROXY_ROTATE=

# Where candidates come from. YOUTUBE_PROXY_LIST (inline, comma-separated) wins if set;
# otherwise the URL is fetched and cached. The default URL is a third-party list refreshed
# every 30 minutes — point it somewhere you control if you would rather not depend on it.
YOUTUBE_PROXY_LIST=
YOUTUBE_PROXY_LIST_URL=

# Tuning. Defaults: 24 candidates, 6 at a time, 5s per attempt, 45s total.
# Concurrency is what makes this work — serially it succeeds about a third as often.
YOUTUBE_PROXY_MAX_ATTEMPTS=
YOUTUBE_PROXY_CONCURRENCY=
YOUTUBE_PROXY_TIMEOUT=
YOUTUBE_PROXY_DEADLINE=
